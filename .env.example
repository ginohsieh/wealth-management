# Wealth Management – Environment Variables
# Copy this file to .env and adjust values before running docker-compose.
#
# All variables have sensible defaults for local development so the app
# starts out-of-the-box without any configuration.

# ── PostgreSQL connection ─────────────────────────────────────────────────────
# Individual variables (used when DATABASE_URL is not set)
DB_HOST=postgres          # hostname of the postgres container (or external host)
DB_PORT=5432              # postgres port inside the container
DB_NAME=wealthdb          # database name
DB_USER=wealthuser        # database user
DB_PASSWORD=wealthpass    # database password — change this in production!
DB_SSLMODE=disable        # set to "require" for production deployments

# Alternative: provide a full DSN (takes precedence over individual vars above)
# DATABASE_URL=postgres://wealthuser:wealthpass@postgres:5432/wealthdb?sslmode=disable

# ── Host port for direct postgres access (optional, for local dev tooling) ───
DB_PORT_EXTERNAL=5432

# ── Price poller (configured at runtime via the UI or PUT /api/price-config) ─
# PRICE_SOURCE=yahoo          # yahoo | alphavantage
# PRICE_INTERVAL=300          # poll interval in seconds (min 60)
# ALPHA_VANTAGE_KEY=          # required when PRICE_SOURCE=alphavantage
